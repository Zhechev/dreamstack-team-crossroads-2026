# Copy to .env and fill in. Never commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # embeddings (text-embedding-3-small)

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=              # Postgres connection string (Drizzle migrations, seeder)

# --- Payments: Base Sepolia + x402 ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org   # use a dedicated RPC for the connector: the public one returns stale reads
FACILITATOR_URL=https://x402.org/facilitator
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
GAS_FUNDER_PRIVATE_KEY=    # pays gas for gasless budget funding and seeds each problem wallet with ETH for the refund
PROBLEM_WALLET_SECRET=     # 32 bytes hex, encrypts problem-wallet keys at rest: openssl rand -hex 32
BUYER_PRIVATE_KEY=         # dev only: buyer wallet with test USDC for the fund-problem and price-check:live scripts (the app uses MetaMask)

# --- Expert agents (Stall) ---
AGENT_SIGNING_KEY=         # signs SignedOutcome
AGENT_PAYOUT_ADDRESS=      # demo expert receives x402 payments here
STALL_URL=http://localhost:4020

# --- Buyer connector ---
CONNECTOR_URL=http://localhost:4010
CONNECTOR_PUBLIC_URL=      # public base URL of the connector (Server Card links); derived from the request if empty
WEB_APP_URL=               # Lovable app, for approval and receipt links
ALLOWED_ORIGINS=           # extra CORS origins, comma-separated (Lovable domains and localhost are allowed)
