# Copy to .env and fill in. Never commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # embeddings (text-embedding-3-small)

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=              # Postgres connection string (Drizzle migrations, seeder)

# --- Payments: Base Sepolia + x402 ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org   # use a dedicated RPC for the connector: the public one returns stale reads
FACILITATOR_URL=https://x402.org/facilitator
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
GAS_FUNDER_PRIVATE_KEY=    # seeds each problem wallet with a little ETH for the refund transfer

# --- Expert agents (Stall) ---
AGENT_SIGNING_KEY=         # signs SignedOutcome
AGENT_PAYOUT_ADDRESS=      # demo expert receives x402 payments here
STALL_URL=http://localhost:4020

# --- Buyer connector ---
CONNECTOR_URL=http://localhost:4010
WEB_APP_URL=               # Lovable app, for approval and receipt links
